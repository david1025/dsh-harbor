<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.9</Version>
    <AssemblyName>DSHHarbor</AssemblyName>
    <Product>DSH Harbor</Product>
    <Description>Community-maintained Windows desktop launcher for DeepSeek Harness</Description>
    <Authors>DSH Harbor contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Assets\dsh-harbor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\dsh-harbor.ico" />
  </ItemGroup>
</Project>
